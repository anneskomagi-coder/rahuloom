#!/bin/sh
# Runs type-checking and linting before every push so a broken build
# can't reach the remote (and Vercel). Bypass with `git push --no-verify`.

echo "pre-push: running npm run verify (tsc + eslint)..."

npm run verify
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "pre-push: verify failed — push aborted."
  echo "Fix the errors above, or use 'git push --no-verify' to skip (not recommended)."
  exit 1
fi

echo "pre-push: verify passed."
exit 0
